NODE_ENV=development
SERVICE_NAME=hono-drizzle-just
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
LOG_LEVEL=info
HTTP_DEFAULT_TIMEOUT_MS=10000
HTTP_DEFAULT_ATTEMPT_TIMEOUT_MS=3000
HTTP_MAX_REQUEST_BODY_BYTES=1048576
HTTP_TRANSPORT_MAX_REQUEST_BODY_BYTES=2097152
HTTP_TRUSTED_PROXY_CIDRS=
HEALTH_CHECK_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
AUTH_DEV_STATIC_ENABLED=false
AUTH_DEV_STATIC_BEARER_TOKEN=
AUTH_DEV_STATIC_SUBJECT=
AUTH_DEV_STATIC_TENANT_ID=
AUTH_DEV_STATIC_SCOPES=
