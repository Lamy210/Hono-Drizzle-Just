                    "up",
                    "down"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "durationMs"
              ],
              "type": "object"
            },
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "UpdateUserRequest": {
        "anyOf": [
          {
            "properties": {
              "email": {
                "example": "lamy@example.com",
                "format": "email",
                "type": "string"
              },
              "name": {
                "example": "Lamy",
